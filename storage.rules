rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /project-covers/{projectId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && (
          request.auth.token.email == "novexahub.net@gmail.com"
          || request.auth.token.email == "admin@novexahub.live"
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
