{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novexahub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "novexahub.live/*", "zone_name": "novexahub.live" },
    { "pattern": "www.novexahub.live/*", "zone_name": "novexahub.live" },
    { "pattern": "admin.novexahub.live/*", "zone_name": "novexahub.live" },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "novexahub",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "vars": {
    "NEXTJS_ENV": "production",
    "NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyAqo-mx1cFSuz_mkhNbdQ8OlmcZqUY79Yk",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "novexahub-live.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "novexahub-live",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "novexahub-live.firebasestorage.app",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "385096466335",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:385096466335:web:4a54a80f51b772bccf47aa",
  },
}
