{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novexahub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "novexahub.live/*", "zone_name": "novexahub.live" },
    { "pattern": "www.novexahub.live/*", "zone_name": "novexahub.live" },
    { "pattern": "admin.novexahub.live/*", "zone_name": "novexahub.live" },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "novexahub",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "vars": {
    "NEXTJS_ENV": "production",
    "NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyB-XAdX4OqU-jV8mnqKU7k59ui8V9Pyifg",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "novexa-4876f.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "novexa-4876f",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "novexa-4876f.firebasestorage.app",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "667964243190",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:667964243190:web:9f76e484adae6f39e400d7",
    "NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID": "G-38S619SN4K",
  },
}
