# Firebase web client config — public by design (it ships to every browser).
# These values are already listed in wrangler.jsonc for the runtime worker, but
# wrangler vars are NOT visible to `next build`. NEXT_PUBLIC_* keys must exist
# in the build environment or the client bundle gets undefined values and the
# whole site silently falls back to localStorage mode (admin-published projects
# never reach visitors). Keep this file committed so Cloudflare's build always
# inlines them.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAqo-mx1cFSuz_mkhNbdQ8OlmcZqUY79Yk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=novexahub-live.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=novexahub-live
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=novexahub-live.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=385096466335
NEXT_PUBLIC_FIREBASE_APP_ID=1:385096466335:web:4a54a80f51b772bccf47aa
